{
  "manifest_version": 3,
  "name": "Keep Watching",
  "version": "1.6.0",
  "description": "Su StreamingCommunity passa da solo all'episodio successivo, salta intro e titoli, con timer, statistiche locali e aggiornamenti.",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "notifications"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Keep Watching",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "commands": {
    "toggle-enabled": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Attiva o sospendi Keep Watching"
    },
    "quick-skip": {
      "suggested_key": {
        "default": "Alt+Shift+Right"
      },
      "description": "Salto avanti (durata scelta nel menu)"
    },
    "skip-intro": {
      "suggested_key": {
        "default": "Alt+Shift+S"
      },
      "description": "Salta intro"
    },
    "show-shortcuts": {
      "suggested_key": {
        "default": "Alt+Shift+H"
      },
      "description": "Guida alle scorciatoie sul player"
    },
    "mark-intro": {
      "description": "Segna la fine dell'intro"
    },
    "mark-credits": {
      "description": "Segna l'inizio dei titoli"
    },
    "stop-at-end": {
      "description": "Stop a fine episodio"
    }
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "player_autoplay",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://vixcloud.co/embed/*",
        "*://*.vixcloud.co/embed/*",
        "*://vixcloud.cc/embed/*",
        "*://*.vixcloud.cc/embed/*"
      ],
      "js": [
        "src/defaults.js",
        "src/lib/stats.js",
        "src/lib/health.js",
        "src/panel.js",
        "src/toolbar.js",
        "src/guide.js",
        "src/player.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*/*/iframe/*",
        "*://*/*/watch/*"
      ],
      "js": [
        "src/hosts.js",
        "src/autoplay-permission.js",
        "src/cinema.js",
        "src/recovery.js",
        "src/site-health.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
