{
  "manifest_version": 3,
  "name": "Keep_Watching",
  "version": "1.2.1",
  "description": "Su StreamingCommunity passa da solo all'episodio successivo, con conto alla rovescia, avvio con audio e schermo intero.",
  "permissions": [
    "storage",
    "declarativeNetRequest",
    "notifications"
  ],
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Keep_Watching",
    "default_popup": "src/popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "background": {
    "service_worker": "src/background.js"
  },
  "commands": {
    "toggle-enabled": {
      "suggested_key": {
        "default": "Alt+Shift+K"
      },
      "description": "Attiva o sospendi Keep_Watching"
    }
  },
  "declarative_net_request": {
    "rule_resources": [
      {
        "id": "player_autoplay",
        "enabled": true,
        "path": "rules.json"
      }
    ]
  },
  "content_scripts": [
    {
      "matches": [
        "*://vixcloud.co/embed/*",
        "*://*.vixcloud.co/embed/*"
      ],
      "js": [
        "src/defaults.js",
        "src/panel.js",
        "src/player.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    },
    {
      "matches": [
        "*://*/*/iframe/*",
        "*://*/*/watch/*"
      ],
      "js": [
        "src/autoplay-permission.js",
        "src/cinema.js"
      ],
      "all_frames": true,
      "run_at": "document_start"
    }
  ]
}
